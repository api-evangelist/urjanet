  "info": {
    "_postman_id": "08df5f09-3173-412f-a560-93c1005ecb95",
    "name": "Urjanet Utility Cloud Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Urjanet (now part of Arcadia) utility-data aggregation platform, also branded as the Arcadia \"Arc\" / Utility Cloud platform. The API lets you connect end-user utility account credentials and retrieve normalized utility data — statements/bills, meters, sites, and usage — across thousands of utility providers. Endpoints below reflect resource paths described in Arcadia's public Utility Cloud API documentation; request and response schemas are not fully published and are intentionally left unspecified rather than fabricated. Verify against the official reference at https://docs.arcadia.com/v1.0-Utility-Cloud/reference/introduction before use.\n\nContact Support:\n Name: Arcadia / Urjanet Support",
      "type": "text/plain"
    }
  }
