          "name": "Obtain a bearer token",
          "request": {
            "name": "Obtain a bearer token",
            "description": {
              "content": "Authenticate with username and password to obtain a bearer token used in the Authorization header for subsequent requests. Request and response schemas are not publicly documented in full.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "0baa1db8-9d81-4e70-900a-54c4f94676ba",
              "name": "A bearer token for authenticating subsequent API requests.",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
